#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
if ! getent group scanner >/dev/null; then addgroup --system scanner; fi
# Rule changes take effect after reconnecting the scanner. A container has no udev daemon.
if command -v udevadm >/dev/null 2>&1 && [ -d /run/udev ]; then udevadm control --reload-rules; fi
exit 0
